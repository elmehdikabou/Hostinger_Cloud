# var/ contient la base d'inventaire : la carte complete de l'hebergement,
# avec les noms des bases, les utilisateurs MySQL et les faiblesses reperees.
#
# Elle ne passe par aucune page de connexion si le fichier SQLite est servi
# directement par le serveur web — d'ou ce refus, place au plus pres.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
